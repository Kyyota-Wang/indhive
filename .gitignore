# Secrets — never commit. Production uses `wrangler secret put`.
.dev.vars
V1/.dev.vars

# Dependencies and build caches
node_modules/
V1/.wrangler/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Partner-supplied source material (PMX-103 input package).
# These documents carry the partner's own confidentiality marking
# (21 CFR 312.130, sponsor-attributable trade secret). Committing them is a
# decision for the partner to make, not a side effect of `git add -A`.
inputs/
indkit/out/
reports/

# The tamper demo's working copy. It is a verbatim copy of the partner's package,
# made so a number can be changed without touching their files, and it carries the
# same confidentiality marking they do. Never commit it.
Data/POC data/outputs/tamper/

# Reference document: a 153 MB FOIA-released FDA review file (IND 36,357).
# Too large for GitHub and not needed to build or run anything here.
inputs/reference/*.pdf

# Git metadata from the tool that first scaffolded the pipeline folder
.git.codex-bak/

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic IND Source Case",
  "type": "object",
  "required": ["case_id", "case_label", "scenario_type", "source_records"],
  "properties": {
    "case_id": { "type": "string" },
    "case_label": { "type": "string" },
    "scenario_type": {
      "type": "string",
      "enum": ["clean", "missing", "conflict", "unusual_formatting"]
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "record_type", "title", "source_type", "fields"],
        "properties": {
          "record_id": { "type": "string" },
          "record_type": { "type": "string" },
          "title": { "type": "string" },
          "source_type": { "type": "string" },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IND Module 1 POC Validation Result",
  "type": "object",
  "required": ["case_id", "summary", "issues"],
  "properties": {
    "case_id": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["PASS", "WARNING", "MISSING", "CONFLICT"],
      "properties": {
        "PASS": { "type": "integer" },
        "WARNING": { "type": "integer" },
        "MISSING": { "type": "integer" },
        "CONFLICT": { "type": "integer" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "check_id", "message"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PASS", "WARNING", "MISSING", "CONFLICT"]
          },
          "check_id": { "type": "string" },
          "field": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}

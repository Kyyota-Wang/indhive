  "plan": {
    "rationale": "AVC-101 is an oral small-molecule inhibitor intended to address the limited treatment options for participants with recurrent low-grade serous ovarian cancer, a tumour type that responds poorly to conventional cytotoxic chemotherapy. Nonclinical studies support an acceptable margin between the pharmacologically active exposure and exposures associated with toxicity.",
    "general_approach": "Development will proceed sequentially. A first-in-human dose-escalation study will characterise safety, tolerability and pharmacokinetics and identify a recommended dose. Expansion at that dose will provide a preliminary assessment of antitumour activity before any decision to proceed to a randomised study.",
    "first_year_scope": "One Phase 1 dose-escalation study with a dose-expansion component is planned in the first year following submission. No additional clinical studies are planned during that period.",
    "estimated_enrollment": "Approximately 36 participants (up to 24 in dose escalation and 12 in dose expansion).",
    "anticipated_risks": "Based on repeat-dose toxicology in rat and dog, the anticipated risks of particular severity are reversible hepatocellular injury observed at exposures above the proposed starting dose, and dose-dependent neutropenia. Liver function tests and absolute neutrophil counts are protocol-specified stopping criteria."
  },
  "planned_studies": [
    {
      "study_id": "AVC101-101",
      "title": "A Phase 1 Study of AVC-101 in Participants with Recurrent Low-Grade Serous Ovarian Cancer",
      "objectives": "To determine the safety, tolerability and maximum tolerated dose of oral AVC-101; to characterise single- and multiple-dose pharmacokinetics; to make a preliminary assessment of antitumour activity.",
      "design": "Open-label, single-arm, 3+3 dose escalation followed by dose expansion at the recommended dose.",
      "sample_size": "Up to 36 participants; no formal sample size calculation was performed for this preliminary study.",
      "population": "Adults with histologically confirmed recurrent low-grade serous ovarian cancer who have received at least one prior line of systemic therapy.",
      "parameters": "Safety and tolerability by adverse events, laboratory tests, ECG and physical examination. Pharmacokinetic parameters include Cmax, Tmax and AUC. Antitumour activity assessed by RECIST v1.1.",
      "status": "Protocol submitted with this Initial IND. Enrolment has not started.",
      "source_record": "investigational_plan"
    }
  ],

  "plan": {
    "rationale": "RNV-220 is an inhaled agent intended to provide once-daily control of moderate persistent asthma with lower systemic exposure than currently available oral therapy. Nonclinical inhalation toxicology supports evaluation in humans at the proposed doses.",
    "general_approach": "A first-in-human study in healthy adult volunteers will establish safety, tolerability and systemic exposure following single and repeat inhaled doses before any study is conducted in participants with asthma.",
    "first_year_scope": "One Phase 1 single- and multiple-ascending-dose study in healthy adult volunteers is planned in the first year. A patient study is contemplated thereafter but its protocol has not been developed.",
    "estimated_enrollment": "Approximately 48 healthy adult volunteers across all dose cohorts.",
    "anticipated_risks": "Anticipated risks of particular severity are bronchospasm following inhaled administration and, at the highest planned doses, the systemic corticosteroid-like effects seen in 13-week dog inhalation toxicology. Spirometry is performed before and after each dose, and rescue medication is available at the site."
  },
  "planned_studies": [
    {
      "study_id": "RNV220-101",
      "title": "A Phase 1 Study of RNV-220 in Healthy Adult Volunteers",
      "objectives": "To evaluate the safety and tolerability of single and multiple ascending inhaled doses of RNV-220 and to characterise systemic pharmacokinetics.",
      "design": "Randomised, double-blind, placebo-controlled, single- and multiple-ascending-dose study.",
      "sample_size": "Approximately 48 participants, 8 per cohort randomised 6:2 active to placebo.",
      "population": "Healthy adults aged 18 to 55 with normal spirometry and no history of reactive airway disease.",
      "parameters": "Adverse events, spirometry, vital signs, ECG, clinical laboratory tests, and plasma pharmacokinetics.",
      "status": "Protocol submitted with this Initial IND. Enrolment has not started.",
      "source_record": "investigational_plan"
    }
  ],

  "plan": {
    "rationale": "CNV-512 is an intravenous agent intended to improve exercise capacity in heart failure with preserved ejection fraction, a condition with no approved disease-modifying therapy. A prior Phase 1 study in healthy volunteers established tolerability across the dose range now proposed.",
    "general_approach": "Development moves directly to a Phase 2a study in the target population, using exercise capacity and haemodynamic endpoints to establish proof of mechanism before a larger efficacy study is designed.",
    "first_year_scope": "One Phase 2a study in adults with heart failure with preserved ejection fraction is planned in the first year following submission.",
    "estimated_enrollment": "Approximately 60 participants randomised across two dose levels and placebo.",
    "anticipated_risks": "Anticipated risks of particular severity are symptomatic hypotension during and shortly after infusion, and renal function decline observed at supratherapeutic exposures in the 26-week rat study. Blood pressure is monitored throughout infusion and creatinine is a protocol-specified stopping criterion."
  },
  "planned_studies": [
    {
      "study_id": "CNV512-102",
      "title": "A Phase 2a Study of CNV-512 in Adults with Heart Failure with Preserved Ejection Fraction",
      "objectives": "To assess the effect of CNV-512 on exercise capacity and to evaluate safety and tolerability in the target population.",
      "design": "Randomised, double-blind, placebo-controlled, parallel-group study with two active dose levels.",
      "sample_size": "Approximately 60 participants, 20 per arm.",
      "population": "Adults with heart failure with preserved ejection fraction, NYHA class II to III, with an ejection fraction of at least 50 percent.",
      "parameters": "Primary endpoint is change in six-minute walk distance. Safety assessed by adverse events, blood pressure, renal function and ECG.",
      "status": "Protocol submitted with this Initial IND. Enrolment has not started.",
      "source_record": "investigational_plan"
    }
  ],
